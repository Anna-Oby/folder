<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_HR_Actual" targetNamespace="https://example.org/bpmn/hr-actual" exporter="Kimi Work" exporterVersion="3.0">
  <bpmn:process id="Process_HR_Actual" name="Ежемесячное закрытие и обновление HR-факта из 1С" isExecutable="false">
    <bpmn:laneSet id="LaneSet_HR_Actual">
      <bpmn:lane id="Lane_User" name="Пользователь (HR / ДРП)">
        <bpmn:flowNodeRef>Task_FixMapping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectVersion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixCalculation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Система (1С + бюджетная система)">
        <bpmn:flowNodeRef>StartEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExportMapping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Mapping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LoadActual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Calculate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Payments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Controls</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent" name="5-й рабочий день месяца, следующего за отчётным">
      <bpmn:timerEventDefinition id="Timer_MonthlyClose">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">5-й рабочий день месяца, следующего за отчётным</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:task id="Task_ExportMapping" name="Сформировать выгрузку из 1С&#10;и применить мэппинг РСБУ → МСФО" />
    <bpmn:exclusiveGateway id="Gateway_Mapping" name="Мэппинг и контрольные суммы в порядке?" />
    <bpmn:task id="Task_FixMapping" name="Исправить мэппинг&#10;или исходные данные" />
    <bpmn:task id="Task_LoadActual" name="Загрузить проводки&#10;в Actual / HR Actual" />
    <bpmn:task id="Task_SelectVersion" name="Выбрать периметр и версию&#10;бюджета / прогноза" />
    <bpmn:task id="Task_Calculate" name="Рассчитать начисления и соцвзносы:&#10;1/3 квартальной и 1/12 годовой суммы" />
    <bpmn:task id="Task_Payments" name="Отнести выплаты к периодам начисления&#10;и сформировать сторно (или нули)">
      <bpmn:documentation>По каждой выплате и соответствующим соцвзносам: при наличии факта отнести сумму к периоду начисления и сторнировать начисления за 3 или 12 месяцев; при отсутствии факта сторно равно нулю.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Task_Reconcile" name="Повторить расчёт, сверить итоги&#10;и проверить дубли HR Actual" />
    <bpmn:exclusiveGateway id="Gateway_Controls" name="Контроли пройдены?" />
    <bpmn:task id="Task_FixCalculation" name="Исправить данные / параметры&#10;и повторить расчёт" />
    <bpmn:task id="Task_Approve" name="Проверить и утвердить&#10;HR Actual" />
    <bpmn:exclusiveGateway id="Gateway_Approved" name="HR Actual утверждён?" />
    <bpmn:task id="Task_Publish" name="Передать HR-data в отчётные формы&#10;и значения Finance по мэппингу" />
    <bpmn:task id="Task_Log" name="Зафиксировать версию, журнал&#10;и уведомить участников" />
    <bpmn:endEvent id="EndEvent" name="HR-факт закрыт" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent" targetRef="Task_ExportMapping" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ExportMapping" targetRef="Gateway_Mapping" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_Mapping" targetRef="Task_LoadActual" name="Да" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_Mapping" targetRef="Task_FixMapping" name="Нет" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_FixMapping" targetRef="Task_ExportMapping" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_LoadActual" targetRef="Task_SelectVersion" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_SelectVersion" targetRef="Task_Calculate" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Calculate" targetRef="Task_Payments" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_Payments" targetRef="Task_Reconcile" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Reconcile" targetRef="Gateway_Controls" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_Controls" targetRef="Task_Approve" name="Да" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_Controls" targetRef="Task_FixCalculation" name="Нет" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_FixCalculation" targetRef="Task_Reconcile" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Approve" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_Approved" targetRef="Task_Approve" name="Нет" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_Approved" targetRef="Task_Publish" name="Да" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Publish" targetRef="Task_Log" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Log" targetRef="EndEvent" />
    <bpmn:textAnnotation id="Annotation_BonusRules">
      <bpmn:text>ПРАВИЛА ВЫПЛАТ И СТОРНО
Есть выплата:
• cash и соцвзносы → период
  начисления;
• сторно = −начисления
  за 3 / 12 месяцев.
Нет выплаты: сторно = 0.
Февраль → декабрь ПГ (Q4)
Май → март (Q1)
Август → июнь (Q2)
Ноябрь → сентябрь (Q3)
Годовой → декабрь ПГ
ПГ = предыдущий год</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_BonusRules" sourceRef="Task_Payments" targetRef="Annotation_BonusRules" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_HR_Actual">
