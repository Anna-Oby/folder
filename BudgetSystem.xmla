            "partitions": [
              {
                "name": "Version",
                "dataView": "full",
                "source": {
                  "type": "query",
                  "query": "SELECT * FROM dbo.tbl_Version",
                  "dataSource": "cnn_BudgetSystem"
                },
                "annotations": [
                  {
                    "name": "QueryEditorSerialization",
                    "value": "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>SELECT * FROM dbo.tbl_Version</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                  }
                ]
              }
            ],
            "measures": [
              {
                "name": "Selected Version",
                "expression": " LASTNONBLANK('Version'[Version], [Version])"
              },
              {
                "name": "Selected Version_Id",
                "expression": " LASTNONBLANK('Version'[Version_Id], [Version_Id])"
              },
              {
                "name": "Selected Version Month_Id_Start",
                "expression": " LASTNONBLANK('Version'[Month_Id_Start], [Month_Id_Start])"
              },
              {
                "name": "Selected Version Year",
                "expression": " LASTNONBLANK('Version'[Year], [Year])"
              },
              {
                "name": "SS Selected Version Year",
                "expression": "CALCULATE([Selected Version Year], FILTER('Version', [Scenario_Id]=9))"
              },
              {
                "name": "Selected Version Label",
                "expression": " LASTNONBLANK('Version'[Version Label], [Version Label])"
              }
            ],
            "hierarchies": [
              {
                "name": "Scenario-Year-Version",
                "levels": [
                  {
                    "name": "Scenario",
                    "ordinal": 0,
                    "column": "Scenario"
                  },
                  {
                    "name": "Year",
                    "ordinal": 1,
                    "column": "Year"
                  },
                  {
                    "name": "Version",
                    "ordinal": 2,
                    "column": "Version Name"
                  }
                ]
              }
