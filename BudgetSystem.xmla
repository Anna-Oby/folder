              {
                "name": "Amount",
                "dataType": "double",
                "sourceColumn": "Amount",
                "sourceProviderType": "Double"
              }
            ],
            "partitions": [
              {
                "name": "tbl_MG_COMPENSATION_Log_Monthly",
                "dataView": "full",
                "source": {
                  "type": "query",
                  "query": " SELECT [dbo].[tbl_MG_COMPENSATION_Log_Monthly].* FROM [dbo].[tbl_MG_COMPENSATION_Log_Monthly] ",
                  "dataSource": "cnn_BudgetSystem"
                }
              }
            ],
            "measures": [
              {
                "name": "Amount_Movement",
                "expression": [
                  " IF (HASONEVALUE('Currency'[Currency Code])",
                  "                   ,IF([Component_Type]= \"Demography\"",
                  "                         ,SUMX(",
                  "\t\t    VALUES(MG_COMPENSATION_Log[Person_Id]), -- Перебор уникальных сотрудников в текущем контексте",
                  "\t\t    CALCULATE([Amount_MVT],",
                  "\t\t        LASTNONBLANK(",
                  "\t\t            'Calendar'[Month_Id], ",
                  "\t\t            [Amount_MVT]",
                  "\t\t        )",
                  "\t\t    )",
                  "\t\t)",
                  "\t         ,IF ([CURR]=\"LOCAL\"",
                  "\t                ,[Amount_MVT]",
                  "\t                ,[Amount_MVT]",
                  "\t     \t)",
                  "\t         )",
                  "\t   , BLANK()",
                  "\t)",
                  "",
                  ""
                ],
                "formatString": "#,##0;-#,##0;-"
              },
              {
                "name": "Amount_MVT",
                "expression": "CALCULATE(sum([Amount]),FILTER(MG_COMPENSATION_Log,[Version_Id_Selected]=[Selected Version_Id]&&[Version_Id_Compared]=[Compared Version_Id]))"
              }
            ],
            "annotations": [
              {
                "name": "_TM_ExtProp_QueryDefinition",
                "value": " SELECT [dbo].[tbl_MG_COMPENSATION_Log_Monthly].* FROM [dbo].[tbl_MG_COMPENSATION_Log_Monthly] "
              },
