                "annotations": [
                  {
                    "name": "QueryEditorSerialization",
                    "value": [
                      "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>select *",
                      "from\tdbo.tbl_MG_COMPENSATION_Monthly ",
                      "where Version_Id = 0</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                    ]
                  }
                ]
              },
              {
                "name": "FC6+6_2026_20260531_20260531_EALABERDIN_2026-07-15 09:43:21",
                "dataView": "full",
                "source": {
                  "type": "query",
                  "query": [
                    "select *",
                    "from\tdbo.tbl_MG_COMPENSATION_Monthly ",
                    "where\tLegal_Id not in (select Descendant_Legal_Id from dxa.tbl_D_LEGAL_Descendants where Legal = 'Other Subs')",
                    "and Version_Id in (332, 333)"
                  ],
                  "dataSource": "cnn_BudgetSystem"
                }
              }
            ],
            "measures": [
              {
                "name": "Value",
                "expression": [
                  " IF (HASONEVALUE('Currency'[Currency Code])",
                  "                   ,IF([Component_Type]= \"Demography\"",
                  "                         ,CALCULATE(sum([Amount]),LASTNONBLANK('Calendar'[Month_Id], sum([Amount])))",
                  "\t         ,IF ([CURR]=\"LOCAL\"",
                  "\t                ,SUM([Amount])",
                  "\t                ,SUMX(NATURALINNERJOIN(MG_COMPENSATION, FX_Rates),[Amount]*[Fx_Rate])",
                  "\t     \t)",
                  "\t         )",
                  "\t   , BLANK()",
                  "\t)",
                  ""
                ],
                "formatString": "#,##0;-#,##0;-"
              },
              {
                "name": "CURR",
                "expression": " LASTNONBLANK('Currency'[Currency Code],[Currency Code])",
                "isHidden": true
              },
              {
                "name": "Value PY",
                "expression": " CALCULATE([Value], PARALLELPERIOD('Calendar'[Month Start Date],-12,MONTH))",
                "formatString": "#,##0;-#,##0;-",
                "isHidden": true,
                "displayFolder": "Prior Year"
              },
              {
                "name": "Value PM",
                "expression": " CALCULATE([Value], PARALLELPERIOD('Calendar'[Month Start Date],-1,MONTH))",
                "formatString": "#,##0;-#,##0;-",
                "isHidden": true,
                "displayFolder": "Prior Month"
              },
              {
                "name": "Value vs PY",
                "expression": "[Value]-[Value PY]",
                "formatString": "#,##0;-#,##0;-",
                "isHidden": true,
                "displayFolder": "Prior Year"
              },
              {
                "name": "Value vs PM",
                "expression": "[Value]-[Value PM]",
                "formatString": "#,##0;-#,##0;-",
                "isHidden": true,
                "displayFolder": "Prior Month"
              },
              {
                "name": "Value vs PY, %",
                "expression": "DIVIDE([Value vs PY],[Value PY])",
                "formatString": "0%;-0%;-",
                "isHidden": true,
                "displayFolder": "Prior Year"
              },
              {
                "name": "Value vs PM, %",
                "expression": "DIVIDE([Value vs PM],[Value PM])",
                "formatString": "0%;-0%;-",
                "isHidden": true,
                "displayFolder": "Prior Month"
              },
              {
                "name": "Total Salary",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL3]=\"Total Salary\")) --- [Total Vacation Pay]",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Total Discretionary Bonus",
                "expression": "CALCULATE([COMP Value], FILTER(Component,[LVL4]=\"Total Discretionary Bonus\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Total Discretionary Bonus excl. BT",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL5]=\"Total Discretionary Bonus excl. Business Trip\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Total Business Trip",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL5]=\"Total Business Trip\"))",
                "displayFolder": "Components"
              },
              {
                "name": "Total Bonus Cash",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL6]=\"Total Bonus Cash\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Total Deferral",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL6]=\"Total Deferral\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "COMP Value",
                "expression": "[Value]/*IF(CALCULATE(CALCULATE([Value],FILTER(Scenario,[Scenario Code]=\"COMP\")),ALL(Scenario))=0,BLANK(),CALCULATE(CALCULATE([Value],FILTER(Scenario,[Scenario Code]=\"COMP\"),FILTER('Calendar',[Month Short Name]=\"Dec\")), ALL(Scenario)))*/",
                "isHidden": true
              },
              {
                "name": "Rate_Value",
                "expression": [
                  "MAX([Rate])",
                  ""
                ],
                "isHidden": true
              },
              {
                "name": "Regional Top Up, %",
                "expression": "CALCULATE([Rate_Value], FILTER(Component,[LVL4]=\"Monthly Regional Top Up\"))",
                "isHidden": true
              },
              {
                "name": "Northern Top Up, %",
                "expression": "CALCULATE([Rate_Value], FILTER(Component,[LVL4]=\"Monthly Northern Top Up\"))",
                "isHidden": true
              },
              {
                "name": "RN Top Up",
                "expression": "[Regional Top Up, %]+[Northern Top Up, %]",
                "isHidden": true
              },
              {
                "name": "Value BUD",
                "expression": "CALCULATE(CALCULATE([Value], FILTER(Scenario,[Scenario] = \"Budget\")),ALL(Scenario))",
                "isHidden": true,
                "displayFolder": "Budget"
              },
              {
                "name": "Value vs BUD",
                "expression": "[Value]-[Value BUD]",
                "isHidden": true,
                "displayFolder": "Budget"
              },
              {
                "name": "Value vs BUD, %",
                "expression": "DIVIDE([Value vs BUD],[Value BUD])",
                "formatString": "0%;-0%;-",
                "isHidden": true,
                "displayFolder": "Budget"
              },
              {
                "name": "Value BUD_CHARGE",
                "expression": "CALCULATE(CALCULATE([Value], FILTER(Scenario,[Scenario Code]= \"BUD_CHARGE\")),ALL(Scenario))",
                "isHidden": true
              },
              {
                "name": "Total Quarterly Bonus",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL5]=\"Total Quarterly Bonus\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Total Vacation Pay",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL3]=\"Total Vacation Pay\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Quarterly Bonus Cash",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL6]=\"Quarterly Bonus\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Deferred Quarterly Bonus",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL6]=\"Deferred Quarterly Bonus\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Total Social Tax",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL2]=\"Total Social Tax\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Social Tax Salary",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL4]=\"Social Tax (Total Salary)\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Social Tax Vacation Pay",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL3]=\"Social Tax Vacation Pay\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Total Benefits",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL2]=\"Total Benefits\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Split_Salary",
                "expression": "DIVIDE([Total Salary], CALCULATE([Total Salary], ALL('Legal Structure'), ALL('Global Unit')))",
                "formatString": "0.00%;-0.00%;0.00%",
                "isHidden": true
              },
              {
                "name": "Social Tax (Quarterly Bonus)",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL4]=\"Social Tax (Quarterly Bonus)\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Value FC",
                "expression": "CALCULATE(CALCULATE([Value], FILTER(Scenario,[Scenario] = \"Forecast 6+6 Finance\")),ALL(Scenario))",
                "isHidden": true
              },
              {
                "name": "Salary Uplift",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL4]=\"Salary Uplift\")) --- [Total Vacation Pay]",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Annual Bonus Cash",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL7]=\"Annual Cash Bonus\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Annual Bonus Cash Northern Top Up",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL7]=\"Annual Bonus Cash Northern Top Up\"))+CALCULATE([Value], FILTER(Component,[LVL7]=\"Bonus Northern Top Up\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Annual Bonus Cash Regional Top Up",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL7]=\"Annual Bonus Cash Regional Top Up\"))+CALCULATE([Value], FILTER(Component,[LVL7]=\"Bonus Regional Top Up\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "ACT-COMP",
                "expression": [
                  "CALCULATE(CALCULATE(CALCULATE([Total Discretionary Bonus excl. BT],FILTER(Scenario,[Scenario Code]=\"ACT\")),All(Scenario)),FILTER(Scenario,[Scenario Code]=\"NONE\"))",
                  "-CALCULATE(CALCULATE(CALCULATE([Total Discretionary Bonus excl. BT],ALL(Scenario)),FILTER(Scenario,[Scenario Code]=\"COMP\")),FILTER(Scenario,[Scenario Code]=\"NONE\"))"
                ],
                "formatString": "#,##0;-#,##0;-",
                "isHidden": true
              },
              {
                "name": "CurrentMonth",
                "expression": " SWITCH([Scenario_Default],\"ACT\", [CY_Month],\"NOM\", [CY_Month], [CY_Month])",
                "isHidden": true
              },
              {
                "name": "CY_Month",
                "expression": " LASTNONBLANK('Calendar'[Month_Id],sum([Amount]))",
                "isHidden": true
              },
              {
                "name": "Value M",
                "expression": " [Value]/1000000",
                "formatString": "#,##0.00;-#,##0.00;-",
                "isHidden": true
              },
              {
                "name": "Social Tax(Total Discretionary Bonus)",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL4]=\"Social Tax (Total Discretionary Bonus)\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Heacount",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL2]=\"Headcount\")) ",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "MSU Salary",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL2]=\"MSU based on Salary\")) ",
                "formatString": "#,##0.00;-#,##0.00;-",
                "displayFolder": "Components"
              },
              {
                "name": "Social Tax (Salary Uplift)",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL4]=\"Social Tax (Salary Uplift)\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Social Tax (Quarterly Bonus Uplift)",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL4]=\"Social Tax (Quarterly Bonus Uplift)\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Quarterly Bonus Uplift",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL6]=\"Quarterly Bonus Uplift\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "SS_Value",
                "expression": [
                  " CALCULATE([Value], FILTER(Scenario, [Scenario Code] = \"SS_Old\"))",
                  "",
                  ""
                ],
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "SS vs COMP"
              },
              {
                "name": "COMP_Value",
                "expression": " CALCULATE([Value], FILTER(Scenario, [Scenario Code] = \"COMP\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "SS vs COMP"
              },
              {
                "name": "SSvsCOMP",
                "expression": "IF([Scenario Selected]=\"SSvsCOMP\"&&[Year Selected]=[SS Selected Version Year], [SS_Value_Scenario]-[COMP_Value_SS_Year], BLANK())",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "SS vs COMP"
              },
              {
                "name": "COMP_Value_SS_Year",
                "expression": "CALCULATE(CALCULATE([COMP Value], FILTER('Calendar',[Year] = [SS Selected Version Year]-1)), ALL('Calendar'[Year]), ALL(Scenario))",
                "isHidden": true
              },
              {
                "name": "SS_Value_Scenario",
                "expression": [
                  "CALCULATE([SS_Value], ALL(Scenario))",
                  "\t\t"
                ],
                "isHidden": true
              },
              {
                "name": "SSvsCOMP_Driver_LEAVER",
                "expression": "CALCULATE([SSvsCOMP], FILTER(Person_NetStatus, [Label]=\"LEAVER\"||[Label]=\"LEAVER_PY\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "SS vs COMP\\Drivers"
              },
              {
                "name": "SSvsCOMP_Driver_HIRE",
                "expression": "CALCULATE([SSvsCOMP], FILTER(Person_NetStatus, [Label]=\"HIRE\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "SS vs COMP\\Drivers"
              },
              {
                "name": "SSvsCOMP_Driver_ADJUSTMENT",
                "expression": "CALCULATE([SSvsCOMP], FILTER(Person_NetStatus, [Label]=\"HIRE_PY\"||[Label]=\"CURRENT_MATERNITY\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "SS vs COMP\\Drivers"
              },
              {
                "name": "SSvsCOMP_Driver_TRANSFER",
                "expression": "CALCULATE([SSvsCOMP], FILTER(Person_NetStatus, [Label]=\"TRANSFER\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "SS vs COMP\\Drivers"
              },
              {
                "name": "SSvsCOMP_Driver_FX_and_OTHER",
                "expression": "ROUND(CALCULATE([SSvsCOMP], FILTER(Person_NetStatus, [Label]=\"CURRENT\"||[Label]=\"CURRENT_NOT_BONUS_ELIGIBLE\"||[Label]=\"CURRENT_HNWI\")), 0)",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "SS vs COMP\\Drivers"
              },
              {
                "name": "SS_HC",
                "expression": "CALCULATE(DISTINCTCOUNT(MG_COMPENSATION[Person_Id]), FILTER(Scenario,[Scenario Code]=\"SS_Old\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "SS vs COMP"
              },
              {
                "name": "COMP_HC",
                "expression": "CALCULATE(DISTINCTCOUNT(MG_COMPENSATION[Person_Id]), FILTER(Scenario,[Scenario Code]=\"COMP\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "SS vs COMP"
              },
              {
                "name": "SSvsCOMP HC",
                "expression": "IF([Scenario Selected]=\"SSvsCOMP\"&&[Year Selected]=[SS Selected Version Year], [SS_HC_Scenario]-[COMP_HC_SS_Year], BLANK())",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "SS vs COMP"
              },
              {
                "name": "COMP_HC_SS_Year",
                "expression": "CALCULATE(CALCULATE([COMP_HC], FILTER('Calendar',[Year] = [SS Selected Version Year]-1)), ALL('Calendar'[Year]), ALL(Scenario))",
                "isHidden": true
              },
              {
                "name": "SS_HC_Scenario",
                "expression": [
                  "CALCULATE([SS_HC], ALL(Scenario))",
                  "\t\t"
                ],
                "isHidden": true
              },
              {
                "name": "Severance",
                "expression": "CALCULATE([Value], FILTER(Component,[LVL4]=\"Severance\"))",
                "formatString": "#,##0;-#,##0;-",
                "displayFolder": "Components"
              },
              {
                "name": "Salary_Apportion",
                "expression": "DIVIDE([Total Salary], CALCULATE([Total Salary],ALL('Legal Structure')))",
                "formatString": "0,0%;;"
              },
              {
                "name": "CV_Value",
                "expression": [
                  "IF([IsFiltered_Compared_Version_Calendar]=TRUE()",
                  "\t\t,CALCULATE(CALCULATE([Value],FILTER('Version',[Version_Id]=[Compared Version_Id]),FILTER('Calendar',[Year]=[Compared_Year])),ALL('Version'),All('Calendar'))",
                  "\t\t,CALCULATE(CALCULATE([Value],FILTER('Version',[Version_Id]=[Compared Version_Id])),ALL('Version'))",
                  "\t\t)"
                ],
                "formatString": "#,##0;-#,##0;-"
              },
              {
                "name": "SVvsCV",
                "expression": "IF(abs([Value]-[CV_Value])<1,BLANK(),[Value]-[CV_Value])",
                "formatString": "#,##0;-#,##0;-",
                "isHidden": true
              },
              {
                "name": "SM%CV",
                "expression": "DIVIDE([SVvsCV],[CV_Value])",
                "formatString": "# ##0.00%;-# ##0.00%;-",
                "isHidden": true
              }
            ],
            "annotations": [
              {
                "name": "_TM_ExtProp_DataSourceID",
                "value": "808c2fd4-7d4c-4ac6-b787-725b1515d950"
              },
              {
                "name": "_TM_ExtProp_IsLogical",
                "value": "True"
              },
              {
                "name": "_TM_ExtProp_FriendlyName",
                "value": "MG_COMPENSATION"
              },
              {
                "name": "_TM_ExtProp_DbSchemaName",
                "value": "dbo"
              },
              {
                "name": "_TM_ExtProp_DbTableName",
                "value": "tbl_MG_COMPENSATION_Monthly"
              },
              {
                "name": "_TM_ExtProp_TableType",
                "value": "View"
              },
              {
                "name": "_TM_ExtProp_Description",
                "value": "vw_MG_COMPENSATION_Monthly"
              },
              {
                "name": "_TM_ExtProp_QueryDefinition",
                "value": [
                  "select *",
                  "from\tdbo.tbl_MG_COMPENSATION_Monthly ",
                  "where\tLegal_Id not in (select Descendant_Legal_Id from dxa.tbl_D_LEGAL_Descendants where Legal = 'Other Subs')"
                ]
              },
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>select *",
                  "from\tdbo.tbl_MG_COMPENSATION_Monthly ",
                  "where Scenario_Id = 11</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          },
