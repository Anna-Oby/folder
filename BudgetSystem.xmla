            "measures": [
              {
                "name": "BrowseDepth",
                "expression": "ISFILTERED([LVL0])+ISFILTERED([LVL1])+ISFILTERED([LVL2])+ISFILTERED([LVL3])+ISFILTERED([LVL4])+ISFILTERED([LVL5])+ISFILTERED([LVL6])+ISFILTERED([LVL7])",
                "isHidden": true
              },
              {
                "name": "MaxNodeDepth",
                "expression": "MAX([Level])",
                "isHidden": true
              },
              {
                "name": "Show",
                "expression": [
                  "IF([BrowseDepth] >= [MaxNodeDepth] + 1, BLANK (),",
                  "            \t\tIF ( [BrowseDepth] = [MaxNodeDepth] + 1 ,",
                  "                \t\tIF (AND (VALUES (Component[IsLeaf] ) = FALSE, COUNT([ID]) <> 0), COUNT([ID]), BLANK ()),",
                  "\t               COUNT([ID])))",
                  ""
                ],
                "isHidden": true
              },
              {
                "name": "Component_Type",
                "expression": " LASTNONBLANK(Component[Component Type],[Component Type])"
              }
