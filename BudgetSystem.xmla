                "type": "calculated",
                "name": "LVL3",
                "dataType": "string",
                "isDataTypeInferred": true,
                "expression": "IF([Organization Level] >= 4, LOOKUPVALUE ([Organization], [Organization_Id], PATHITEM ( [PATH], 4, 1)), [Organization])"
