                "type": "calculated",
                "name": "LVL2",
                "dataType": "string",
                "isDataTypeInferred": true,
                "isHidden": true,
                "expression": "IF([Organization Level] >=3, LOOKUPVALUE ([Organization], [Organization_Id], PATHITEM ( [PATH], 3, 1)), [Organization])"
              },
