            "measures": [
              {
                "name": "BrowseDepth_Organization",
                "expression": "ISFILTERED([LVL0])+ISFILTERED([LVL1])+ISFILTERED([LVL2])+ISFILTERED([LVL3])+ISFILTERED([LVL4])+ISFILTERED([LVL5])+ISFILTERED([LVL6])+ISFILTERED([LVL7])",
                "isHidden": true
              },
              {
                "name": "MaxNodeDepth_Organization",
                "expression": "MAX([Organization Level])",
                "isHidden": true
              },
              {
                "name": "Show_Organization",
                "expression": [
                  "IF([BrowseDepth_Organization] >= [MaxNodeDepth_Organization] + 1, BLANK (),",
                  "            \t\tIF ( [BrowseDepth_Organization] = [MaxNodeDepth_Organization] + 1 ,",
                  "                \t\tIF (AND (VALUES (Organization[IsLeaf] ) = FALSE, COUNT([Organization_Id]) <> 0), COUNT([Organization_Id]), BLANK ()),",
                  "\t               COUNT([Organization_Id])))",
                  ""
                ]
              }
            ],
