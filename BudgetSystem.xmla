                  "dataSource": "cnn_BudgetSystem"
                },
                "annotations": [
                  {
                    "name": "QueryEditorSerialization",
                    "value": "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>SELECT * FROM dxa.vw_NS_TIME_MonthView</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                  }
                ]
              }
            ],
            "measures": [
              {
                "name": "IsFiltered_Calendar",
                "expression": [
                  "ISFILTERED([Month_Id]) || ISFILTERED([Month Name]) || ISFILTERED([Month Full Name]) || ISFILTERED([Month Short Full Name]) || ISFILTERED([Month Short Name]) || ISFILTERED([Month Number]) || ISFILTERED([Month Start Date]) || ISFILTERED([Month End Date]) ||",
                  "ISFILTERED([Quarter]) || ISFILTERED([Quarter_Id]) || ISFILTERED([QUARTER_NUM]) ||",
                  "ISFILTERED([Year])"
                ],
                "isHidden": true
              },
              {
                "name": "Calendar_Default_Month_Id",
                "expression": [
                  " IF([IsFiltered_Calendar]=TRUE()",
                  "\t\t      \t         ,MAX([Month_Id])",
                  "\t\t     \t         ,CALCULATE(MAX([Month_Id]), FILTER('Calendar', [Default_Member] = TRUE()))",
                  "\t\t     \t         )"
                ],
                "isHidden": true
              },
              {
                "name": "Year Selected",
                "expression": "LASTNONBLANK('Calendar'[Year], [Year])"
              }
            ],
            "hierarchies": [
              {
                "name": "Month View",
                "levels": [
                  {
                    "name": "Year",
                    "ordinal": 0,
                    "column": "Year"
                  },
                  {
                    "name": "Month",
                    "ordinal": 1,
                    "column": "Month Short Full Name"
                  }
                ]
