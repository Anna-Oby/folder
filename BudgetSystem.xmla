                "isNameInferred": true,
                "isDataTypeInferred": true,
                "sourceColumn": "Calendar[Month Short Name]"
              },
              {
                "type": "calculatedTableColumn",
                "name": "Month_Id",
                "dataType": "int64",
                "isNameInferred": true,
                "isDataTypeInferred": true,
                "isHidden": true,
                "sourceColumn": "Calendar[Month_Id]"
              }
            ],
            "partitions": [
              {
                "name": "CalculatedTable 1",
                "source": {
                  "type": "calculated",
                  "expression": "SUMMARIZECOLUMNS('Calendar'[Year],'Calendar'[Month_Id],'Calendar'[Month Name],'Calendar'[Month Full Name],'Calendar'[Month Short Name],'Calendar'[Month Short Full Name])"
                }
              }
            ],
            "measures": [
              {
                "name": "Compared_Year",
                "expression": "LASTNONBLANK('Compared Version Calendar'[Year], [Year])",
                "isHidden": true
              },
              {
                "name": "IsFiltered_Compared_Version_Calendar",
                "expression": "ISFILTERED([Month_Id]) || ISFILTERED([Month Name]) || ISFILTERED([Month Full Name]) || ISFILTERED([Month Short Full Name]) || ISFILTERED([Month Short Name])||ISFILTERED([Year])",
                "isHidden": true
              },
              {
                "name": "Compared_Version_Month_Id",
                "expression": "LASTNONBLANK('Compared Version Calendar'[Month_Id], [Month_Id])",
                "isHidden": true
              }
            ],
            "hierarchies": [
              {
                "name": "Month View",
                "levels": [
                  {
                    "name": "Year",
                    "ordinal": 0,
                    "column": "Year"
                  },
                  {
                    "name": "Month Short Full Name",
                    "ordinal": 1,
                    "column": "Month Short Full Name"
                  }
                ]
              }
            ]
          },
