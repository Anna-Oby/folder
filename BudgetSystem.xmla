                  "query": "SELECT * FROM [dxa].[vw_D_ORGANIZATION]",
                  "dataSource": "cnn_BudgetSystem"
                },
                "annotations": [
                  {
                    "name": "QueryEditorSerialization",
                    "value": "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>SELECT * FROM [dxa].[vw_D_ORGANIZATION]</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
