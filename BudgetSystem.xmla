                "type": "calculated",
                "name": "LVL0",
                "dataType": "string",
                "isDataTypeInferred": true,
                "isHidden": true,
                "expression": "IF([Organization Level] >= 1, LOOKUPVALUE ([Organization], [Organization_Id], PATHITEM ( [PATH], 1, 1)), [Organization])"
              },
              {
                "type": "calculated",
                "name": "LVL1",
                "dataType": "string",
                "isDataTypeInferred": true,
                "isHidden": true,
                "expression": "IF([Organization Level] >= 2, LOOKUPVALUE ([Organization], [Organization_Id], PATHITEM ( [PATH], 2, 1)), [Organization])"
              },
