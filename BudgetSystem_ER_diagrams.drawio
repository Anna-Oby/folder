  <diagram id="er05" name="05 Несвязанные сущности">
    <mxGraphModel dx="1643" dy="957" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_1" value="Несвязанные сущности — в XMLA нет рёбер (срезы и группы расчёта)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="40" y="12" width="1600" height="32" as="geometry" />
        </mxCell>
        <mxCell id="note_2" value="Это не нарушение модели: объекты намеренно отвязаны, чтобы фильтровать меры сравнения версий, не отсекая факт по активным связям «звезды».&#xa;Compared Version / Compared Version Calendar читают те же SQL-источники, что Version и Calendar, но живут отдельно.&#xa;TimeDataView и Calc Group Compare Versions — группы расчёта табличной модели SSAS." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
