  <diagram id="er06" name="06 Орг. измерения">
    <mxGraphModel dx="2191" dy="1276" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1750" math="0" shadow="0">
